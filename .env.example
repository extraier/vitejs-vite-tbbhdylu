# Firebase configuration — copy to .env.local and fill in your project values.
# Vite reads VITE_*-prefixed vars at build time.
#
# These are the keys for the production "savetheday-2377a" project.
# They are PUBLIC API keys (Firebase client SDKs need them to identify the
# project) — security is enforced via Firestore/Storage SECURITY RULES, not
# by hiding this config. Do NOT commit your .env.local file.

VITE_FIREBASE_API_KEY=AIzaSy...mEXs
VITE_FIREBASE_AUTH_DOMAIN=savetheday-2377a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=savetheday-2377a
VITE_FIREBASE_STORAGE_BUCKET=savetheday-2377a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1076306848030
VITE_FIREBASE_APP_ID=1:1076306848030:web:067794edd31cb2cdb3410f
VITE_FIREBASE_MEASUREMENT_ID=G-LH4S4CEBK1

# NAS photo upload endpoint (Tailscale Funnel address). This stays
# client-side ONLY so the front-end can show a useful error if it's
# not configured. The actual upload goes through the
# /api/photo-upload Vercel proxy, which reads the HMAC secret from
# its own server env (see NAS_UPLOAD_SECRET below).
VITE_NAS_UPLOAD_URL=

# 2026-07-27 — REMOVED `VITE_NAS_UPLOAD_SECRET`. The HMAC secret is no
# longer bundled into the public JavaScript (a partner could extract
# it from DevTools and mint valid upload tokens). The secret now
# lives only on the Vercel proxy as NAS_UPLOAD_SECRET (or one of
# the legacy aliases PHOTO_UPLOAD_SECRET / PHOTO_HMAC_SECRET) and
# is mirrored on the NAS at /home/openclaw/.config/photo-upload/
# server_secret. Both endpoints receive it via env vars ONLY.
NAS_UPLOAD_SECRET=
# PHOTO_HMAC_SECRET (NAS side; mounted into /home/openclaw/.config/
# photo-upload/server_secret via systemd's EnvironmentFile=)
# PHOTO_HMAC_SECRET=
PHOTO_TOKEN_TTL_MS=300000

# Firebase Storage rules — separate from the NAS upload path. Leave
# blank to skip Storage entirely (we did, back on 2026-07-04).
